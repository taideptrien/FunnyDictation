# YouTube Data API v3 Key (optional but recommended for search feature)
# Get one free at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Server port (default: 5001)
# PORT=5001

# Groq API keys for AI transcription fallback (when video has NO subtitles)
# Get free keys at: https://console.groq.com/keys
# IMPORTANT: Groq rate limits (RPM/RPD) apply at the ACCOUNT level — all keys
# under the same Gmail share the same quota. So keys are grouped by account:
#   GROQ_ACCOUNTS_JSON = JSON array of { accountName, keys[] }
# Add more accounts (more Gmails) to increase total quota.
# GROQ_ACCOUNTS_JSON=[{"accountName":"gmail_1","keys":["gsk_key1","gsk_key2"]},{"accountName":"gmail_2","keys":["gsk_key3"]}]
